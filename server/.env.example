# Copy to .env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas free tier works)
MONGO_URI=
# Long random string used to sign login tokens (and to derive push keys if VAPID_* is empty)
JWT_SECRET=

# --- Server -----------------------------------------------------------------
PORT=5000
# Web app URL(s), comma-separated. Used for CORS and for links in emails.
CLIENT_URL=http://localhost:5173

# --- Optional: AI first-aid assistant (Google Gemini) -----------------------
GEMINI_API_KEY=

# --- Optional: "Sign in with Google" -----------------------------------------
GOOGLE_CLIENT_ID=

# --- Optional: emails (verification, password reset, approvals) via Gmail API
# Leave GMAIL_CLIENT_ID empty to turn email off (recommended for local testing).
# Render's free plan blocks SMTP, so mail goes out over the Gmail API (HTTPS).
#
# One-time setup:
#  1. console.cloud.google.com: create a project and enable the "Gmail API".
#  2. Google Auth Platform (or "APIs & Services > OAuth consent screen"):
#     - External user type.
#     - Under Audience, click "Publish app". While the app is in "Testing",
#       Google expires the refresh token after 7 days and email stops.
#  3. Clients > Create client > Web application. Add this authorised redirect URI:
#       https://developers.google.com/oauthplayground
#     Copy the client ID and secret into GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET.
#  4. Open developers.google.com/oauthplayground.
#     - Gear icon: tick "Use your own OAuth credentials" and paste the ID and secret.
#     - Step 1: enter https://www.googleapis.com/auth/gmail.send and click "Authorize APIs".
#     - Sign in as GMAIL_USER. If "Google hasn't verified this app" appears, click
#       Advanced > Go to app. This is expected for a personal app.
#     - Step 2: click "Exchange authorization code for tokens" and copy the
#       refresh token into GMAIL_REFRESH_TOKEN.
#  If you publish the app after creating a token, make a new token (step 4).
#  Tokens created while the app was in "Testing" still expire after 7 days.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# --- Optional: push notification keys ----------------------------------------
# If empty, a key pair is derived from JWT_SECRET automatically.
# Generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Set to true to stop sending notifications (for local testing against the real database).
DISABLE_PUSH=
