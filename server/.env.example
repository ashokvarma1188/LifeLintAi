# Copy to .env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas free tier works)
MONGO_URI=
# Long random string used to sign login tokens (and to derive push keys if VAPID_* is empty)
JWT_SECRET=

# --- Server -----------------------------------------------------------------
PORT=5000
# Web app URL(s), comma-separated. Used for CORS and for links in emails.
CLIENT_URL=http://localhost:5173

# --- Optional: AI first-aid assistant (Google Gemini) -----------------------
GEMINI_API_KEY=

# --- Optional: "Sign in with Google" -----------------------------------------
GOOGLE_CLIENT_ID=

# --- Optional: emails (verification, password reset, approvals) via Gmail API
# Leave GMAIL_CLIENT_ID empty to turn email off (recommended for local testing).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# --- Optional: push notification keys ----------------------------------------
# If empty, a key pair is derived from JWT_SECRET automatically.
# Generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
