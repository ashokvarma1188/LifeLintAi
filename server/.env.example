# Copy to .env and fill in real values. Never commit the real .env.

# MongoDB Atlas connection string.
# If mongodb+srv:// times out with "querySrv ETIMEOUT", use the long
# non-SRV form with the three shard hosts instead.
MONGO_URI=your_mongodb_connection_string_here

# Any long random string. Changing it signs everyone out.
JWT_SECRET=change_this_to_a_long_random_string

# Local only. Hosting platforms set PORT themselves.
PORT=5000

# Production only: the deployed frontend URL, e.g.
# CLIENT_URL=https://lifelink.vercel.app
# Comma-separate to allow more than one. Leave empty in development.
CLIENT_URL=

# Powers the AI First-Aid Assistant widget. Get a free key at aistudio.google.com/apikey.
# Leave empty to disable the assistant (it replies with a "not configured" message).
GEMINI_API_KEY=

# Sends real "reset your password" emails via Gmail SMTP.
# EMAIL_USER is the Gmail address; EMAIL_PASS is a 16-character Gmail "App Password"
# (Google Account -> Security -> 2-Step Verification -> App Passwords), not your login password.
# Leave both empty and forgot-password still works — the API hands back the reset link directly.
EMAIL_USER=
EMAIL_PASS=
