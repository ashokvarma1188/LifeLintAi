# Copy to .env and fill in real values. Never commit the real .env.

# MongoDB Atlas connection string.
# If mongodb+srv:// times out with "querySrv ETIMEOUT", use the long
# non-SRV form with the three shard hosts instead.
MONGO_URI=your_mongodb_connection_string_here

# Any long random string. Changing it signs everyone out.
JWT_SECRET=change_this_to_a_long_random_string

# Local only. Hosting platforms set PORT themselves.
PORT=5000

# Production only: the deployed frontend URL, e.g.
# CLIENT_URL=https://lifelink.vercel.app
# Comma-separate to allow more than one. Leave empty in development.
CLIENT_URL=

# Powers the AI First-Aid Assistant widget. Get a free key at aistudio.google.com/apikey.
# Leave empty to disable the assistant (it replies with a "not configured" message).
GEMINI_API_KEY=

# Sends real emails (password reset, email verification, 2FA codes) via the
# Gmail API over HTTPS — plain SMTP is blocked outbound on Render's free tier.
# One-time setup in Google Cloud Console:
#   1. Create a project, enable the Gmail API
#   2. Google Auth Platform -> Audience: add your Gmail as a test user
#   3. Google Auth Platform -> Data access: add scope .../auth/gmail.send
#   4. Google Auth Platform -> Clients -> Create client (Web application),
#      redirect URI: https://developers.google.com/oauthplayground
#      -> copy the Client ID and Client secret
#   5. On https://developers.google.com/oauthplayground, gear icon -> check
#      "Use your own OAuth credentials" -> paste Client ID/secret -> Close
#   6. Select "Gmail API v1" -> check https://mail.google.com/ -> Authorize APIs
#      -> sign in -> Exchange authorization code for tokens -> copy Refresh token
# Leave all four empty and these flows still work — the API hands back the
# link/code directly in the response instead of emailing it.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# "Sign in with Google" on Login/Signup — a separate, simpler OAuth client from
# the one above (no secret needed; this one only verifies an ID token). Create
# it in Google Cloud Console -> Credentials -> Create client (Web application),
# with the deployed frontend URL (and http://localhost:5173 for dev) added
# under Authorised JavaScript origins. Must match VITE_GOOGLE_CLIENT_ID in the
# client's env. Leave empty to disable the button.
GOOGLE_CLIENT_ID=
