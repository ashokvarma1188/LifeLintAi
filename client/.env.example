# Copy to .env.local for local development, or set in your host's dashboard.

# Base URL of the backend API, including /api.
# Local:      http://localhost:5000/api
# Production: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# "Sign in with Google" button on Login/Signup. Must match GOOGLE_CLIENT_ID on
# the backend (same value — this one is safe to expose, there's no secret).
# Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=
